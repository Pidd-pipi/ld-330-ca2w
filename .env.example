# 电子病历管理系统（GBEMR）环境变量示例
# 用法：cp .env.example .env，然后按需修改

# Compose 项目名；固定为 gbemr，避免在中文目录名下项目名/容器名异常
COMPOSE_PROJECT_NAME=gbemr

# PostgreSQL 数据库配置（容器内自动创建）
# 数据库名
DB_NAME=gbemr
# 数据库用户名
DB_USER=gbemr_user
# 数据库密码（生产环境请改为强密码）
DB_PASSWORD=change_me_strong_password

# 后端 JWT 签名密钥，用于登录令牌签发与校验（请替换为足够长的随机字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# 前端宿主机访问端口（容器内固定为 Nginx 80）
FRONTEND_PORT=18930

# 后端宿主机访问端口（容器内固定为 3000）
BACKEND_PORT=19930
